{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FeatureManagement": {
    "JwtAuthentication": false
  },
  "RateLimiting": {
    "PermitLimit": 60,
    "Window": "00:01:00"
  },
  "ConnectionStrings": {
    "cache": "localhost:6379"
  },
  "WeatherProviders": {
    "OpenWeatherMap": {
      "Enabled": true,
      "BaseAddress": "https://api.openweathermap.org/",
      "ApiKey": "test",
      "CacheDuration": "00:10:00",
      "FallbackDuration": "06:00:00",
      "Resilience": {
        "Retry": {
          "MaxRetryAttempts": 2,
          "Delay": "00:00:00.200",
          "BackoffType": "Exponential",
          "UseJitter": true
        },
        "AttemptTimeout": { "Timeout": "00:00:03" },
        "TotalRequestTimeout": { "Timeout": "00:00:10" },
        "CircuitBreaker": {
          "FailureRatio": 0.5,
          "MinimumThroughput": 5,
          "SamplingDuration": "00:00:30",
          "BreakDuration": "00:00:15"
        }
      }
    },
    "OpenMeteo": {
      "Enabled": true,
      "BaseAddress": "https://api.open-meteo.com/",
      "CacheDuration": "00:10:00",
      "FallbackDuration": "06:00:00",
      "Resilience": {
        "Retry": {
          "MaxRetryAttempts": 2,
          "Delay": "00:00:00.200",
          "BackoffType": "Exponential",
          "UseJitter": true
        },
        "AttemptTimeout": { "Timeout": "00:00:03" },
        "TotalRequestTimeout": { "Timeout": "00:00:10" },
        "CircuitBreaker": {
          "FailureRatio": 0.5,
          "MinimumThroughput": 5,
          "SamplingDuration": "00:00:30",
          "BreakDuration": "00:00:15"
        }
      }
    },
    "MetNorway": {
      "Enabled": true,
      "BaseAddress": "https://api.met.no/",
      "UserAgent": "PlaygroundApp/1.0",
      "CacheDuration": "00:10:00",
      "FallbackDuration": "06:00:00",
      "Resilience": {
        "Retry": {
          "MaxRetryAttempts": 2,
          "Delay": "00:00:00.200",
          "BackoffType": "Exponential",
          "UseJitter": true
        },
        "AttemptTimeout": { "Timeout": "00:00:03" },
        "TotalRequestTimeout": { "Timeout": "00:00:10" },
        "CircuitBreaker": {
          "FailureRatio": 0.5,
          "MinimumThroughput": 5,
          "SamplingDuration": "00:00:30",
          "BreakDuration": "00:00:15"
        }
      }
    }
  },
  "Statistics": {
    "FastThreshold": "00:00:00.100",
    "SlowThreshold": "00:00:00.200",
    "RecentWindow": "00:05:00"
  },
  "PerformanceMonitoring": {
    "Enabled": true,
    "Interval": "00:01:00",
    "DegradationThreshold": 0.5,
    "MinimumRecentRequests": 3
  }
}
